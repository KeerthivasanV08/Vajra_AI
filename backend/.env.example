# VAJRA Environment Configuration Example

ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://vajra-ai-phi.vercel.app
# CORS_ORIGINS is also accepted as an alias for FRONTEND_ORIGINS.

# Database Mode (csv or postgres)
DATABASE_MODE=csv
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vajra_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=

# Authentication
JWT_SECRET=

# Feature Flags
ENABLE_EXTERNAL_DISPATCH=False
ENABLE_BANK_ACTIONS=False
ENABLE_LEGAL_DOSSIER=True
ENABLE_SIMULATION=True
SYNTHETIC_DATA_MODE=True

# Spatial Configuration
MAP_PROVIDER=leaflet_osm
H3_RESOLUTION=7
