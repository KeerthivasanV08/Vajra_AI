# VAJRA Environment Configuration Example

ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Database Mode (csv or postgres)
DATABASE_MODE=csv
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vajra_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Authentication
JWT_SECRET=vajra_platform_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Feature Flags
ENABLE_EXTERNAL_DISPATCH=False
ENABLE_BANK_ACTIONS=False
ENABLE_LEGAL_DOSSIER=True
ENABLE_SIMULATION=True
SYNTHETIC_DATA_MODE=True

# Spatial Configuration
MAP_PROVIDER=leaflet_osm
H3_RESOLUTION=7
